<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- LocalNuGet stays as a fallback so prerelease bumps can be tested
         without going through nuget.org first. Order: nuget.org wins for
         published versions; LocalNuGet is consulted for versions nuget.org
         doesn't have. -->
    <add key="LocalNuGet" value="C:\LocalNuGet" />
  </packageSources>
</configuration>
