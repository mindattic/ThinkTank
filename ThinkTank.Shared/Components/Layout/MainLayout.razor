@inherits LayoutComponentBase
@inject AppearanceService Appearance
@inject IJSRuntime JS

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="page">
    <NavMenu />
    <main id="main-content" tabindex="-1">
        @Body
    </main>
</div>

@code {
    // Apply the saved appearance (ThinkTank's Vault settings) on first interactive render of any page.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("ThinkTank.setTheme", AppearanceService.ToThemeValue(Appearance.Mode));
        await JS.InvokeVoidAsync("ThinkTank.setControlHeight", Appearance.ControlHeight);
        await JS.InvokeVoidAsync("ThinkTank.setGutter", Appearance.Gutter);
        await JS.InvokeVoidAsync("ThinkTank.setBorderRadius", Appearance.BorderRadius);
    }
}
