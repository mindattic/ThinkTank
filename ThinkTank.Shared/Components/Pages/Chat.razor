    // ── Vote ──

    private const string VoteRequestInstruction =
        "\n\n---\nIf this discussion is at a stalemate, include [REQUEST_VOTE: your question] anywhere in your response to trigger an immediate consensus vote among all participants.";

    private async Task RunParticipantVoteAsync(
        ConversationUiState state,
        ChatConversation active,
        List<SharedTurn> sharedHistory,
        string question,
        int round)
    {
        var ts = DateTimeOffset.UtcNow;
        state.StatusEvents.Add(new StatusEvent(ts, $"Participant called a vote: \"{question}\""));
        active.StatusEvents.Add(new PersistedStatusEvent(ts, $"Participant called a vote: \"{question}\""));

        try
        {
            var result = await VotingService.VoteAsync(
                active.Participants, question, active.Topic ?? "",
                new List<string> { "Yes", "No" }, Quorum.SimpleMajority);

            var voteText = $"[VOTE] Question: {question}\nDecision: {result.Consensus} ({result.ConsensusStrength:P0} agreement)\nSummary: {result.NarrativeSummary}";
            var voteTurn = new SharedTurn { ModelId = "vote", ModelName = "Vote Result", Text = voteText, Round = round };
            sharedHistory.Add(voteTurn);

            var msg = new ConversationUiMessage { ParticipantId = "vote", Text = voteText, Round = round };
            state.Messages.Add(msg);
            active.Messages.Add(new PersistedMessage("vote", voteText, round, false));

            if (result.QuorumReached)
            {
                var notice = $"Quorum reached ({result.ConsensusStrength:P0}). You may wish to stop the conversation.";
                state.StatusEvents.Add(new StatusEvent(DateTimeOffset.UtcNow, notice));
                active.StatusEvents.Add(new PersistedStatusEvent(DateTimeOffset.UtcNow, notice));
            }

            Conversations.NotifyChanged();
        }
        catch (Exception ex)
        {
            var errTs = DateTimeOffset.UtcNow;
            state.StatusEvents.Add(new StatusEvent(errTs, $"Vote failed: {ex.Message}"));
            active.StatusEvents.Add(new PersistedStatusEvent(errTs, $"Vote failed: {ex.Message}"));
        }

        await InvokeAsync(StateHasChanged);
    }

    private enum VoteDialogType { Consensus, FreeForm, Direction }

    private bool _voteDialogVisible;
    private VoteDialogType _voteType = VoteDialogType.Consensus;
    private string _voteQuestion = "Have we reached consensus?";
    private string _voteDirectionOptions = "";
    private bool _voteRunning;
    private string? _voteError;

    private void OpenVoteDialog()
    {
        if (Active is null || Active.Participants.Count < 2) return;
        ActiveState.VotePending = true;
        _voteType = VoteDialogType.Consensus;
        _voteQuestion = "Have we reached consensus?";
        _voteDirectionOptions = "";
        _voteError = null;
        _voteDialogVisible = true;
    }

    private void CancelVoteDialog()
    {
        _voteDialogVisible = false;
        _voteError = null;
        if (Active is not null)
            ActiveState.VotePending = false;
    }

    private void OnVoteTypeChanged(VoteDialogType type)
    {
        _voteType = type;
        _voteQuestion = type switch
        {
            VoteDialogType.Consensus => "Have we reached consensus?",
            VoteDialogType.FreeForm => "What is our conclusion?",
            VoteDialogType.Direction => "What direction should we take next?",
            _ => _voteQuestion
        };
    }

    private async Task SubmitVoteAsync()
    {
        if (Active is null) return;
        _voteDialogVisible = false;
        _voteRunning = true;
        _voteError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var options = _voteType switch
            {
                VoteDialogType.Consensus => new List<string> { "Yes", "No" },
                VoteDialogType.Direction => _voteDirectionOptions.Split(',')
                    .Select(o => o.Trim()).Where(o => !string.IsNullOrWhiteSpace(o)).ToList(),
                _ => new List<string>()
            };
            var quorum = _voteType == VoteDialogType.FreeForm ? Quorum.Plurality : Quorum.SimpleMajority;
            var context = Active.Topic ?? "";

            var result = await VotingService.VoteAsync(Active.Participants, _voteQuestion, context, options, quorum);

            var voteText = $"[VOTE] Question: {_voteQuestion}\nDecision: {result.Consensus} ({result.ConsensusStrength:P0} agreement)\nSummary: {result.NarrativeSummary}";
            var round = ActiveState.Messages.Count > 0 ? ActiveState.Messages.Max(m => m.Round) : 1;

            var msg = new ConversationUiMessage { ParticipantId = "vote", Text = voteText, Round = round };
            ActiveState.Messages.Add(msg);
            Active.Messages.Add(new PersistedMessage("vote", voteText, round, false));
            _pendingUserTurns.Add(new SharedTurn { ModelId = "vote", ModelName = "Vote Result", Text = voteText, Round = round });

            Conversations.NotifyChanged();
        }
        catch (Exception ex)
        {
            _voteError = ex.Message;
            _voteDialogVisible = true;
        }
        finally
        {
            _voteRunning = false;
            if (Active is not null)
                ActiveState.VotePending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Max tokens ──

    private void OnMaxTokensChanged(ChangeEventArgs e)
    {
        if (Active is null) return;
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 64 && val <= 32768)
            Active.MaxTokens = val;
        Conversations.NotifyChanged();
    }

    private void OnMaxRoundsChanged(ChangeEventArgs e)
    {
        if (Active is null) return;
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 1 && val <= 999)
            Active.MaxRounds = val;
        Conversations.NotifyChanged();
    }

    private void OnClaudeFallbackToggled(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        Settings.SetClaudeFallbackMode(enabled);
    }

    // ── Mid-conversation participant add ──

    private bool _showMidConvoAdd;

    private void ToggleMidConvoAdd() => _showMidConvoAdd = !_showMidConvoAdd;

    private void AddParticipantMidConvo(ParticipantTemplate t)
    {
        if (Active is null) return;
        _showMidConvoAdd = false;

        AddParticipant(Active, t);

        var round = ActiveState.Messages.Count > 0 ? ActiveState.Messages.Max(m => m.Round) : 1;
        var announcement = new ConversationUiMessage
        {
            ParticipantId = "system",
            Text = $"{t.DisplayName} has entered the chat.",
            Round = round,
            IsError = false
        };
        ActiveState.Messages.Add(announcement);
        Active.Messages.Add(new PersistedMessage("system", announcement.Text, round, false));
        Conversations.NotifyChanged();
    }

    // ── Export ──

    private async Task ExportTranscript()
    {
        if (Active is null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {Active.Title}");
        sb.AppendLine($"Topic: {Active.Topic}");
        sb.AppendLine($"Exported: {DateTimeOffset.Now:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine();

        foreach (var msg in ActiveState.Messages)
        {
            var name = msg.ParticipantId == "user" ? "You"
                     : msg.ParticipantId == "system" ? "System"
                     : msg.ParticipantId == "vote" ? "Vote Result"
                     : (Active.Participants.FirstOrDefault(p => p.ParticipantId == msg.ParticipantId)?.DisplayName ?? msg.ParticipantId);
            sb.AppendLine($"**{name}** (Round {msg.Round}):");
            sb.AppendLine(msg.Text);
            sb.AppendLine();
        }

        var content = sb.ToString();
        await JS.InvokeVoidAsync("ThinkTank.downloadFile", $"{Active.Title}.md", content);
    }

    // ── Markdown-lite formatting ──

    private static string FormatMessageText(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        text = System.Net.WebUtility.HtmlEncode(text);
        var lines = text.Split('\n');
        var sb = new System.Text.StringBuilder();
        var inTable = false;
        var inList = false;
        var listTag = "ul";

        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var trimmed = line.TrimStart();

            // Table rows
            if (trimmed.StartsWith("|") && trimmed.EndsWith("|"))
            {
                // Skip separator rows like |---|---|
                if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^\|[\s\-:|]+\|$"))
                    continue;

                if (!inTable)
                {
                    CloseList(sb, ref inList, listTag);
                    sb.Append("<table class=\"bubble-table\">");
                    // Check if next line is a separator -> this is a header row
                    var isHeader = i + 1 < lines.Length &&
                        System.Text.RegularExpressions.Regex.IsMatch(lines[i + 1].Trim(), @"^\|[\s\-:|]+\|$");
                    var cells = ParseTableCells(trimmed);
                    var tag = isHeader ? "th" : "td";
                    sb.Append("<tr>");
                    foreach (var cell in cells)
                        sb.Append($"<{tag}>{cell.Trim()}</{tag}>");
                    sb.Append("</tr>");
                    inTable = true;
                    continue;
                }

                var dataCells = ParseTableCells(trimmed);
                sb.Append("<tr>");
                foreach (var cell in dataCells)
                    sb.Append($"<td>{cell.Trim()}</td>");
                sb.Append("</tr>");
                continue;
            }

            if (inTable)
            {
                sb.Append("</table>");
                inTable = false;
            }

            // Numbered list
            if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^\d+[\.\)]\s"))
            {
                if (!inList || listTag != "ol")
                {
                    CloseList(sb, ref inList, listTag);
                    listTag = "ol";
                    sb.Append("<ol>");
                    inList = true;
                }
                var content = System.Text.RegularExpressions.Regex.Replace(trimmed, @"^\d+[\.\)]\s", "");
                sb.Append($"<li>{FormatInline(content)}</li>");
                continue;
            }

            // Bullet list
            if (trimmed.StartsWith("- ") || trimmed.StartsWith("* ") || trimmed.StartsWith("• "))
            {
                if (!inList || listTag != "ul")
                {
                    CloseList(sb, ref inList, listTag);
                    listTag = "ul";
                    sb.Append("<ul>");
                    inList = true;
                }
                var content = trimmed[2..];
                sb.Append($"<li>{FormatInline(content)}</li>");
                continue;
            }

            CloseList(sb, ref inList, listTag);

            // Empty line = paragraph break
            if (string.IsNullOrWhiteSpace(line))
            {
                sb.Append("<br/>");
                continue;
            }

            sb.Append($"{FormatInline(line)}<br/>");
        }

        if (inTable) sb.Append("</table>");
        CloseList(sb, ref inList, listTag);

        return sb.ToString();
    }

    private static string FormatInline(string text)
    {
        // Bold: **text** or __text__
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"__(.+?)__", "<strong>$1</strong>");
        // Italic: *text* or _text_
        text = System.Text.RegularExpressions.Regex.Replace(text, @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", "<em>$1</em>");
        return text;
    }

    private static void CloseList(System.Text.StringBuilder sb, ref bool inList, string tag)
    {
        if (inList)
        {
            sb.Append($"</{tag}>");
            inList = false;
        }
    }

    private static List<string> ParseTableCells(string row)
    {
        var cells = row.Split('|', StringSplitOptions.None);
        // Trim first and last empty entries from leading/trailing pipes
        if (cells.Length >= 2)
            cells = cells[1..^1];
        return cells.ToList();
    }
}
