    private void OnStatusLogTabsKeyDown(KeyboardEventArgs e)
    {
        var tabs = new[] { StatusTab.Perspective, StatusTab.Context, StatusTab.Diagnostics };
        var idx = Array.IndexOf(tabs, _activeStatusTab);
        if (idx < 0) return;

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                _activeStatusTab = tabs[(idx + 1) % tabs.Length];
                break;
            case "ArrowLeft":
            case "ArrowUp":
                _activeStatusTab = tabs[(idx - 1 + tabs.Length) % tabs.Length];
                break;
            case "Home":
                _activeStatusTab = tabs[0];
                break;
            case "End":
                _activeStatusTab = tabs[^1];
                break;
        }

        if (_activeStatusTab == StatusTab.Context)
            _ = RefreshContextFiles();
    }

    private ChatConversation? Active => Conversations.ActiveConversation;
