    private void AddParticipantMidConvo(ParticipantTemplate t)
    {
        if (Active is null) return;
        _showMidConvoAdd = false;

        AddParticipant(Active, t);

        var round = ActiveState.Messages.Count > 0 ? ActiveState.Messages.Max(m => m.Round) : 1;
        var announcement = new ConversationUiMessage
        {
            ParticipantId = "system",
            Text = $"{t.DisplayName} has entered the chat.",
            Round = round,
