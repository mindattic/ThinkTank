    private bool _contextMenuVisible;
    private double _contextMenuX;
    private double _contextMenuY;
    private string? _contextMenuChatId;

    // Rename state
    private bool _renameVisible;
    private string _renameText = "";
    private string? _renameChatId;

    private void OpenTabContextMenu(MouseEventArgs e, string chatId)
    {
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuChatId = chatId;
        _contextMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
        _contextMenuChatId = null;
    }

    private void CloseContextMenuTab()
    {
        if (_contextMenuChatId is not null)
            CloseTab(_contextMenuChatId);
        CloseContextMenu();
    }

    private void StartRenameTab()
    {
        _renameChatId = _contextMenuChatId;
        var convo = Conversations.Conversations.FirstOrDefault(c => c.ChatId == _renameChatId);
        _renameText = convo?.Title ?? "";
        _renameVisible = true;
        CloseContextMenu();
    }

    private void ConfirmRename()
    {
        if (_renameChatId is not null && !string.IsNullOrWhiteSpace(_renameText))
        {
            var convo = Conversations.Conversations.FirstOrDefault(c => c.ChatId == _renameChatId);
            if (convo is not null)
            {
                convo.Title = _renameText.Trim();
                Conversations.NotifyChanged();
            }
        }
        CancelRename();
    }

    private void CancelRename()
    {
        _renameVisible = false;
        _renameChatId = null;
    }

    private void OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ConfirmRename();
        else if (e.Key == "Escape") CancelRename();
    }

    private class ConversationUiMessage
    {
        public string ParticipantId { get; set; } = "";
        public string Text { get; set; } = "";
        public int Round { get; set; }
        public bool IsError { get; set; }
    }

    private class ConversationUiState
    {
        public string Topic { get; set; } = "";
        public bool Running { get; set; }
        public bool StopRequested { get; set; }
        public bool VotePending { get; set; }
        public string? CurrentSpeaker { get; set; }
        public string? Error { get; set; }
        public int TotalTurns { get; set; }
        public int CompletedTurns { get; set; }
        public double ProgressPct => TotalTurns == 0 ? 0 : (CompletedTurns / (double)TotalTurns) * 100;
        public List<ConversationUiMessage> Messages { get; } = new();
        public List<StatusEvent> StatusEvents { get; } = new();
        public List<StatusEvent> Diagnostics { get; } = new();
    }

    private record StatusEvent(DateTimeOffset Timestamp, string Text);

    // ── Vote ──

    private const string VoteRequestInstruction =
        "\n\n---\nIf this discussion is at a stalemate, include [REQUEST_VOTE: your question] anywhere in your response to trigger an immediate consensus vote among all participants.";

    private async Task RunParticipantVoteAsync(
        ConversationUiState state,
        ChatConversation active,
        List<SharedTurn> sharedHistory,
        string question,
        int round)
    {
        var ts = DateTimeOffset.UtcNow;
        state.StatusEvents.Add(new StatusEvent(ts, $"Participant called a vote: \"{question}\""));
        active.StatusEvents.Add(new PersistedStatusEvent(ts, $"Participant called a vote: \"{question}\""));

        try
        {
            var result = await VotingService.VoteAsync(
                active.Participants, question, active.Topic ?? "",
                new List<string> { "Yes", "No" }, Quorum.SimpleMajority);

            var voteText = $"[VOTE] Question: {question}\nDecision: {result.Consensus} ({result.ConsensusStrength:P0} agreement)\nSummary: {result.NarrativeSummary}";
            var voteTurn = new SharedTurn { ModelId = "vote", ModelName = "Vote Result", Text = voteText, Round = round };
            sharedHistory.Add(voteTurn);

            var msg = new ConversationUiMessage { ParticipantId = "vote", Text = voteText, Round = round };
            state.Messages.Add(msg);
            active.Messages.Add(new PersistedMessage("vote", voteText, round, false));

            if (result.QuorumReached)
            {
                var notice = $"Quorum reached ({result.ConsensusStrength:P0}). You may wish to stop the conversation.";
                state.StatusEvents.Add(new StatusEvent(DateTimeOffset.UtcNow, notice));
                active.StatusEvents.Add(new PersistedStatusEvent(DateTimeOffset.UtcNow, notice));
            }

            Conversations.NotifyChanged();
        }
        catch (Exception ex)
        {
            var errTs = DateTimeOffset.UtcNow;
            state.StatusEvents.Add(new StatusEvent(errTs, $"Vote failed: {ex.Message}"));
            active.StatusEvents.Add(new PersistedStatusEvent(errTs, $"Vote failed: {ex.Message}"));
        }

        await InvokeAsync(StateHasChanged);
    }

    private enum VoteDialogType { Consensus, FreeForm, Direction }

    private bool _voteDialogVisible;
    private VoteDialogType _voteType = VoteDialogType.Consensus;
    private string _voteQuestion = "Have we reached consensus?";
    private string _voteDirectionOptions = "";
    private bool _voteRunning;
    private string? _voteError;

    private void OpenVoteDialog()
    {
        if (Active is null || Active.Participants.Count < 2) return;
        ActiveState.VotePending = true;
        _voteType = VoteDialogType.Consensus;
        _voteQuestion = "Have we reached consensus?";
        _voteDirectionOptions = "";
        _voteError = null;
        _voteDialogVisible = true;
    }

    private void CancelVoteDialog()
    {
        _voteDialogVisible = false;
        _voteError = null;
        if (Active is not null)
            ActiveState.VotePending = false;
    }

    private void OnVoteTypeChanged(VoteDialogType type)
    {
        _voteType = type;
        _voteQuestion = type switch
        {
            VoteDialogType.Consensus => "Have we reached consensus?",
            VoteDialogType.FreeForm => "What is our conclusion?",
            VoteDialogType.Direction => "What direction should we take next?",
            _ => _voteQuestion
        };
    }

    private async Task SubmitVoteAsync()
    {
        if (Active is null) return;
        _voteDialogVisible = false;
        _voteRunning = true;
        _voteError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var options = _voteType switch
            {
                VoteDialogType.Consensus => new List<string> { "Yes", "No" },
                VoteDialogType.Direction => _voteDirectionOptions.Split(',')
                    .Select(o => o.Trim()).Where(o => !string.IsNullOrWhiteSpace(o)).ToList(),
                _ => new List<string>()
            };
            var quorum = _voteType == VoteDialogType.FreeForm ? Quorum.Plurality : Quorum.SimpleMajority;
            var context = Active.Topic ?? "";

            var result = await VotingService.VoteAsync(Active.Participants, _voteQuestion, context, options, quorum);

            var voteText = $"[VOTE] Question: {_voteQuestion}\nDecision: {result.Consensus} ({result.ConsensusStrength:P0} agreement)\nSummary: {result.NarrativeSummary}";
            var round = ActiveState.Messages.Count > 0 ? ActiveState.Messages.Max(m => m.Round) : 1;

            var msg = new ConversationUiMessage { ParticipantId = "vote", Text = voteText, Round = round };
            ActiveState.Messages.Add(msg);
            Active.Messages.Add(new PersistedMessage("vote", voteText, round, false));
            _pendingUserTurns.Add(new SharedTurn { ModelId = "vote", ModelName = "Vote Result", Text = voteText, Round = round });

            Conversations.NotifyChanged();
        }
        catch (Exception ex)
        {
            _voteError = ex.Message;
            _voteDialogVisible = true;
        }
        finally
        {
            _voteRunning = false;
            if (Active is not null)
                ActiveState.VotePending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

