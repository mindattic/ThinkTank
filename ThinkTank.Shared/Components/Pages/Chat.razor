        Conversations.NotifyChanged();
    }

    // ── Export ──

    private async Task ExportTranscript()
    {
        if (Active is null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {Active.Title}");
        sb.AppendLine($"Topic: {Active.Topic}");
        sb.AppendLine($"Exported: {DateTimeOffset.Now:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine();

        foreach (var msg in ActiveState.Messages)
        {
            var name = msg.ParticipantId == "user" ? "You"
                     : msg.ParticipantId == "system" ? "System"
                     : msg.ParticipantId == "vote" ? "Vote Result"
                     : (Active.Participants.FirstOrDefault(p => p.ParticipantId == msg.ParticipantId)?.DisplayName ?? msg.ParticipantId);
            sb.AppendLine($"**{name}** (Round {msg.Round}):");
            sb.AppendLine(msg.Text);
            sb.AppendLine();
        }

        var content = sb.ToString();
        await JS.InvokeVoidAsync("ThinkTank.downloadFile", $"{Active.Title}.md", content);
    }

    // ── Markdown-lite formatting ──

    private static string FormatMessageText(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        text = System.Net.WebUtility.HtmlEncode(text);
        var lines = text.Split('\n');
        var sb = new System.Text.StringBuilder();
        var inTable = false;
        var inList = false;
        var listTag = "ul";

        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var trimmed = line.TrimStart();

            // Table rows
            if (trimmed.StartsWith("|") && trimmed.EndsWith("|"))
            {
                // Skip separator rows like |---|---|
                if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^\|[\s\-:|]+\|$"))
                    continue;

                if (!inTable)
                {
                    CloseList(sb, ref inList, listTag);
                    sb.Append("<table class=\"bubble-table\">");
                    // Check if next line is a separator -> this is a header row
                    var isHeader = i + 1 < lines.Length &&
                        System.Text.RegularExpressions.Regex.IsMatch(lines[i + 1].Trim(), @"^\|[\s\-:|]+\|$");
                    var cells = ParseTableCells(trimmed);
                    var tag = isHeader ? "th" : "td";
                    sb.Append("<tr>");
                    foreach (var cell in cells)
                        sb.Append($"<{tag}>{cell.Trim()}</{tag}>");
                    sb.Append("</tr>");
                    inTable = true;
                    continue;
                }

                var dataCells = ParseTableCells(trimmed);
                sb.Append("<tr>");
                foreach (var cell in dataCells)
                    sb.Append($"<td>{cell.Trim()}</td>");
                sb.Append("</tr>");
                continue;
            }

            if (inTable)
            {
                sb.Append("</table>");
                inTable = false;
            }

            // Numbered list
            if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^\d+[\.\)]\s"))
            {
                if (!inList || listTag != "ol")
                {
                    CloseList(sb, ref inList, listTag);
                    listTag = "ol";
                    sb.Append("<ol>");
                    inList = true;
                }
                var content = System.Text.RegularExpressions.Regex.Replace(trimmed, @"^\d+[\.\)]\s", "");
                sb.Append($"<li>{FormatInline(content)}</li>");
                continue;
            }

            // Bullet list
            if (trimmed.StartsWith("- ") || trimmed.StartsWith("* ") || trimmed.StartsWith("• "))
            {
                if (!inList || listTag != "ul")
                {
                    CloseList(sb, ref inList, listTag);
                    listTag = "ul";
                    sb.Append("<ul>");
                    inList = true;
                }
                var content = trimmed[2..];
                sb.Append($"<li>{FormatInline(content)}</li>");
                continue;
            }

            CloseList(sb, ref inList, listTag);

            // Empty line = paragraph break
            if (string.IsNullOrWhiteSpace(line))
            {
                sb.Append("<br/>");
                continue;
            }

            sb.Append($"{FormatInline(line)}<br/>");
        }

        if (inTable) sb.Append("</table>");
        CloseList(sb, ref inList, listTag);

        return sb.ToString();
    }

    private static string FormatInline(string text)
    {
        // Bold: **text** or __text__
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"__(.+?)__", "<strong>$1</strong>");
        // Italic: *text* or _text_
        text = System.Text.RegularExpressions.Regex.Replace(text, @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", "<em>$1</em>");
        return text;
    }

    private static void CloseList(System.Text.StringBuilder sb, ref bool inList, string tag)
    {
        if (inList)
        {
            sb.Append($"</{tag}>");
            inList = false;
        }
    }

    private static List<string> ParseTableCells(string row)
    {
        var cells = row.Split('|', StringSplitOptions.None);
        // Trim first and last empty entries from leading/trailing pipes
        if (cells.Length >= 2)
            cells = cells[1..^1];
        return cells.ToList();
    }
}
