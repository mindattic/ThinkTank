    {
        if (Active is null) return;
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 64 && val <= 32768)
            Active.MaxTokens = val;
        Conversations.NotifyChanged();
    }

    private void OnMaxRoundsChanged(ChangeEventArgs e)
    {
        if (Active is null) return;
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 1 && val <= 999)
            Active.MaxRounds = val;
        Conversations.NotifyChanged();
    }

