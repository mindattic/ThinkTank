@page "/settings"
@namespace ThinkTank.Shared.Components.Pages
@using Microsoft.AspNetCore.Components.Web
@inject SettingsService ThinkTankSettings
@inject ThinkTankService ThinkTank
@inject ChatLogService Chat
@inject HumanNameService HumanNames
@inject NameGeneratorService NameGen
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    <div class="settings-grid">
        <div class="settings-panel">
            <h1 class="visually-hidden">Settings</h1>
            <div class="settings-tabs" role="tablist" aria-label="Settings sections" @onkeydown="OnSettingsTabsKeyDown">
                <button id="tab-personas" class="settings-tab @(_activeSection == SettingsSection.Providers ? "active" : "")"
                        role="tab" aria-selected="@(_activeSection == SettingsSection.Providers ? "true" : "false")"
                        aria-controls="panel-personas" tabindex="@(_activeSection == SettingsSection.Providers ? "0" : "-1")"
                        @onclick="(() => _activeSection = SettingsSection.Providers)">
                    Personas
                </button>
                <button id="tab-defaults" class="settings-tab @(_activeSection == SettingsSection.Defaults ? "active" : "")"
                        role="tab" aria-selected="@(_activeSection == SettingsSection.Defaults ? "true" : "false")"
                        aria-controls="panel-defaults" tabindex="@(_activeSection == SettingsSection.Defaults ? "0" : "-1")"
                        @onclick="(() => _activeSection = SettingsSection.Defaults)">
                    Defaults
                </button>
                <button id="tab-appearance" class="settings-tab @(_activeSection == SettingsSection.Appearance ? "active" : "")"
                        role="tab" aria-selected="@(_activeSection == SettingsSection.Appearance ? "true" : "false")"
                        aria-controls="panel-appearance" tabindex="@(_activeSection == SettingsSection.Appearance ? "0" : "-1")"
                        @onclick="(() => _activeSection = SettingsSection.Appearance)">
                    Appearance
                </button>
            </div>

            @if (_activeSection == SettingsSection.Defaults)
            {
                <div id="panel-defaults" role="tabpanel" aria-labelledby="tab-defaults" class="settings-form" style="padding:1rem;">
                    <label for="defaults-max-tokens">Global Max Tokens</label>
                    <p id="defaults-max-tokens-hint" class="options-hint" style="margin-top:0;">Default max tokens per response. Individual conversations can override this.</p>
                    <input id="defaults-max-tokens" type="number" min="64" max="32768" step="64"
                           value="@(ThinkTankSettings.GlobalMaxTokens ?? 2048)"
                           aria-describedby="defaults-max-tokens-hint"
                           @onchange="OnGlobalMaxTokensChanged" />

                    <label for="defaults-max-rounds" style="margin-top:1rem;">Global Max Rounds</label>
                    <p id="defaults-max-rounds-hint" class="options-hint" style="margin-top:0;">Default max rounds per conversation. Individual conversations can override this.</p>
                    <input id="defaults-max-rounds" type="number" min="1" max="999" step="1"
                           value="@(ThinkTankSettings.GlobalMaxRounds ?? 10)"
                           aria-describedby="defaults-max-rounds-hint"
                           @onchange="OnGlobalMaxRoundsChanged" />

                    <label for="defaults-claude-fallback" style="margin-top:1.25rem; display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                        <input id="defaults-claude-fallback" type="checkbox"
                               checked="@ThinkTankSettings.ClaudeFallbackMode"
                               aria-describedby="defaults-claude-fallback-hint"
                               @onchange="OnClaudeFallbackToggled" />
                        Claude fallback mode
                    </label>
                    <p id="defaults-claude-fallback-hint" class="options-hint" style="margin-top:0;">
                        When other providers are rate-limited or down, route every participant through the Anthropic API.
                        Each persona stays unique — Claude roleplays as ChatGPT, Gemini, Grok, etc. using each participant's
                        personality prompt. Only the Claude API key is used.
                    </p>

                    <p style="margin-top:1.25rem;"><strong>Shared credentials file</strong></p>
                    <p class="options-hint" style="margin-top:0;">
                        API keys live at <code>@SharedCredentialsPath</code>
                    </p>
                    <p class="options-hint" style="margin-top:-0.25rem;">
                        Every MindAttic application reads from and writes to this file, so configuring a key here makes it available across all of them.
                    </p>
                </div>
            }
            else if (_activeSection == SettingsSection.Appearance)
            {
                <div id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance">
                    <SettingsAppearance />
                </div>
            }
            else
            {
                <div id="panel-personas" role="tabpanel" aria-labelledby="tab-personas">
                <div class="templates-split">
                    <div class="templates-left">
                        <div class="templates-left-header">
                            <h2 id="personas-heading" style="margin:0; font-size:1rem;">Personas</h2>
                            <div class="add-dropdown">
                                <button class="settings-tab" @onclick="ToggleAddDropdown"
                                        aria-haspopup="menu" aria-expanded="@(_showAddDropdown ? "true" : "false")"
                                        aria-label="Add a new persona">+ Add</button>
                                @if (_showAddDropdown)
                                {
                                    <div class="add-dropdown-menu" role="menu" aria-label="Add persona for provider">
                                        @foreach (var p in _providerOptions)
                                        {
                                            <button class="add-dropdown-item" role="menuitem" @onclick="(() => AddTemplateForProvider(p.Id))">
                                                <span aria-hidden="true">@GetProviderAvatar(p.Id)</span> @p.Name
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <ul class="templates-left-list" role="list" aria-labelledby="personas-heading">
                            @foreach (var t in ThinkTankSettings.Templates)
                            {
                                <li role="listitem">
                                    <button class="settings-tab template-row @(t.TemplateId == _activeTemplateId ? "active" : "")"
                                            @onclick="(() => SelectTemplate(t.TemplateId))"
                                            aria-pressed="@(t.TemplateId == _activeTemplateId ? "true" : "false")"
                                            aria-label="@($"Select persona {t.DisplayName}{(t.IsDefault ? ", default" : "")}")">
                                        <span class="settings-tab-avatar" aria-hidden="true">@GetProviderAvatar(t.ProviderId)</span>
                                        <span class="template-name">@t.DisplayName</span>
                                        @if (t.IsDefault)
                                        {
                                            <span class="template-default-badge">default</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="templates-right settings-form" aria-live="polite">
                        @if (_activeTemplate is not null)
                        {
                            <label for="persona-display-name">Display name</label>
                            <input id="persona-display-name" value="@_activeTemplate.DisplayName" @oninput="OnTemplateNameChanged" placeholder="e.g. Bob Claude" disabled="@(_activeTemplate.IsDefault)" />

                            <label for="persona-provider">Provider</label>
                            <select id="persona-provider" value="@_activeTemplate.ProviderId" @onchange="OnTemplateProviderChanged" disabled="@(_activeTemplate.IsDefault)">
                                @foreach (var p in _providerOptions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>

                            @* Custom Auth Config - hidden for now, will add later
                            <label>Custom Auth Config (JSON, optional)</label>
                            <textarea class="settings-textarea" @oninput="OnTemplateAuthOverrideChanged" rows="6">@(_activeTemplate.AuthOverrideJson ?? "")</textarea>
                            *@

                            <label for="persona-markdown">Persona (markdown)</label>
                            <textarea id="persona-markdown" class="settings-textarea" @oninput="OnTemplatePersonalityChanged" rows="16" disabled="@(_activeTemplate.IsDefault)" aria-describedby="persona-markdown-hint">@_activeTemplate.PersonalityMarkdown</textarea>
                            <p id="persona-markdown-hint" class="visually-hidden">Markdown describing the persona's voice, values, and habits.</p>

                            <div class="settings-row">
                                <button class="start-btn" @onclick="SaveActiveTemplate" disabled="@(_activeTemplate is null || _activeTemplate.IsDefault)">Save</button>
                                <button class="start-btn" @onclick="TestTemplate" disabled="@_testing" aria-busy="@(_testing ? "true" : "false")">@(_testing ? "Testing…" : "Test connection")</button>
                                <button class="reset-btn" @onclick="RequestRemoveTemplate" disabled="@(_activeTemplate.IsDefault)">Remove</button>
                                <span style="flex:1"></span>
                                <button class="start-btn" @onclick="GeneratePersonality" disabled="@(_generating || _activeTemplate.IsDefault)" aria-busy="@(_generating ? "true" : "false")">@(_generating ? "Generating…" : "Generate")</button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_lastError))
                            {
                                <div class="error-msg" role="alert">@_lastError</div>
                            }
                        }
                    </div>
                </div>
                </div>
            }
        </div>


    </div>
</div>

<ThinkTank.Shared.Components.Shared.ConfirmationDialog @ref="_confirmDialog" />

@code {
    private ThinkTank.Shared.Components.Shared.ConfirmationDialog _confirmDialog = default!;
    private enum SettingsSection { Providers, Defaults, Appearance }

    private string? _activeTemplateId;
    private bool _showAddDropdown;
    private SettingsSection _activeSection = SettingsSection.Providers;
    private bool _testing;
    private string? _lastError;
    private bool _generating;
    private CancellationTokenSource? _templatePersistDebounceCts;

    private ParticipantTemplate? _activeTemplate => _activeTemplateId is null
        ? null
        : ThinkTankSettings.Templates.FirstOrDefault(t => t.TemplateId == _activeTemplateId);

    private readonly List<(string Id, string Name)> _providerOptions = new()
    {
        ("openai", "ChatGPT"),
        ("claude", "Claude"),
        ("gemini", "Gemini"),
        ("deepseek", "DeepSeek"),
        ("mistral", "Mistral"),
        ("xai", "Grok"),
        ("groq", "Groq"),
        ("together", "Together"),
        ("openrouter", "OpenRouter"),
        ("fireworks", "Fireworks"),
        ("cohere", "Cohere")
    };

    protected override void OnInitialized()
    {
        Chat.Changed += OnChatChanged;
        _activeTemplateId ??= ThinkTankSettings.Templates.FirstOrDefault()?.TemplateId;
    }

    private void OnChatChanged() => InvokeAsync(StateHasChanged);

    private void OnSettingsTabsKeyDown(KeyboardEventArgs e)
    {
        var sections = new[] { SettingsSection.Providers, SettingsSection.Defaults, SettingsSection.Appearance };
        var idx = Array.IndexOf(sections, _activeSection);
        if (idx < 0) return;

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                _activeSection = sections[(idx + 1) % sections.Length];
                break;
            case "ArrowLeft":
            case "ArrowUp":
                _activeSection = sections[(idx - 1 + sections.Length) % sections.Length];
                break;
            case "Home":
                _activeSection = sections[0];
                break;
            case "End":
                _activeSection = sections[^1];
                break;
        }
    }

    private void SelectTemplate(string templateId)
    {
        SaveActiveTemplate();
        _activeTemplateId = templateId;
        _lastError = null;
    }

    private string GetProviderAvatar(string providerId)
        => ThinkTank.Models.FirstOrDefault(m => m.Id == providerId)?.Avatar ?? "?";

    private void OnGlobalMaxTokensChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 64 && val <= 32768)
            ThinkTankSettings.SetGlobalMaxTokens(val);
    }

    private void OnGlobalMaxRoundsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val) && val >= 1 && val <= 999)
            ThinkTankSettings.SetGlobalMaxRounds(val);
    }

    private void OnClaudeFallbackToggled(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        ThinkTankSettings.SetClaudeFallbackMode(enabled);
    }

    private string SharedCredentialsPath => MindAtticCredentialStore.ProvidersFilePath;

    private void ToggleAddDropdown()
    {
        _showAddDropdown = !_showAddDropdown;
    }

    private async Task AddTemplateForProvider(string providerId)
    {
        _showAddDropdown = false;
        var llmName = _providerOptions.FirstOrDefault(p => p.Id == providerId).Name;
        var firstName = HumanNames.NextFirstName();
        var fallbackPersonality = $"# {firstName} ({llmName})\n\n- Voice: curious and concise\n- Values: clarity, honesty\n- Habits: asks follow-up questions\n- Biases: may over-generalize\n";

        var template = new ParticipantTemplate(
            TemplateId: ChatConversationsService.NewId(),
            ProviderId: providerId,
            DisplayName: $"{firstName} ({llmName})",
            PersonalityMarkdown: fallbackPersonality,
            AuthOverrideJson: null);

        ThinkTankSettings.Templates.Add(template);
        ThinkTankSettings.SaveTemplates(ThinkTankSettings.Templates);
        _activeTemplateId = template.TemplateId;
        _lastError = null;
        StateHasChanged();

        // Try to generate a richer personality in the background
        try
        {
            var personality = await GenerateStarterPersonality(providerId, firstName, llmName);
            if (personality != fallbackPersonality)
            {
                var idx = ThinkTankSettings.Templates.FindIndex(t => t.TemplateId == template.TemplateId);
                if (idx >= 0)
                {
                    ThinkTankSettings.Templates[idx] = template with { PersonalityMarkdown = personality };
                    ThinkTankSettings.SaveTemplates(ThinkTankSettings.Templates);
                    StateHasChanged();
                }
            }
        }
        catch { /* fallback personality already set */ }
    }

    private async Task<string> GenerateStarterPersonality(string providerId, string firstName, string llmName)
    {
        var prompt = $"Create a short personality profile for a chat participant named {firstName}. " +
                     "Output markdown only. Include: 1) Voice/style, 2) Values, 3) Conversational habits, 4) Biases to watch for. Keep it under 150 words.";

        try
        {
            return await ThinkTank.CallProvider(providerId, "You create short markdown personality profiles.", authOverrideJson: null, topic: prompt, history: new List<SharedTurn>());
        }
        catch
        {
            return $"# {firstName} ({llmName})\n\n- Voice: curious and concise\n- Values: clarity, honesty\n- Habits: asks follow-up questions\n- Biases: may over-generalize\n";
        }
    }

    private async Task RequestRemoveTemplate()
    {
        if (_activeTemplate is null) return;
        var confirmed = await _confirmDialog.ShowAsync(
            "Remove Persona",
            $"Are you sure you want to remove \"{_activeTemplate.DisplayName}\"? This cannot be undone.",
            "Remove");
        if (confirmed) RemoveTemplate();
    }

    private void RemoveTemplate()
    {
        if (_activeTemplate is null)
            return;

        var idx = ThinkTankSettings.Templates.FindIndex(t => t.TemplateId == _activeTemplate.TemplateId);
        ThinkTankSettings.Templates.RemoveAll(t => t.TemplateId == _activeTemplate.TemplateId);
        ThinkTankSettings.SaveTemplates(ThinkTankSettings.Templates);

        if (ThinkTankSettings.Templates.Count == 0)
        {
            _activeTemplateId = null;
            return;
        }

        var nextIdx = Math.Clamp(idx, 0, ThinkTankSettings.Templates.Count - 1);
        _activeTemplateId = ThinkTankSettings.Templates[nextIdx].TemplateId;
        _lastError = null;
    }

    private void UpdateActiveTemplate(Func<ParticipantTemplate, ParticipantTemplate> update)
    {
        if (_activeTemplate is null)
            return;

        var idx = ThinkTankSettings.Templates.FindIndex(t => t.TemplateId == _activeTemplate.TemplateId);
        if (idx < 0)
            return;

        ThinkTankSettings.Templates[idx] = update(ThinkTankSettings.Templates[idx]);
        DebouncePersistTemplates();
    }

    private void DebouncePersistTemplates()
    {
        _templatePersistDebounceCts?.Cancel();
        _templatePersistDebounceCts?.Dispose();
        _templatePersistDebounceCts = new CancellationTokenSource();

        var token = _templatePersistDebounceCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(650), token);
                if (token.IsCancellationRequested)
                    return;

                await InvokeAsync(() => ThinkTankSettings.SaveTemplates(ThinkTankSettings.Templates));
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private void SaveActiveTemplate()
    {
        if (_activeTemplate is null)
            return;

        ThinkTankSettings.SaveTemplates(ThinkTankSettings.Templates);
    }

    private async Task GeneratePersonality()
    {
        _lastError = null;
        if (_activeTemplate is null)
            return;

        _generating = true;
        try
        {
            var prompt = $"Create a detailed markdown personality profile for a chat participant named {_activeTemplate.DisplayName}. " +
                         "Include: voice/style, beliefs, thoughts, biases, rules, and failure modes to avoid. " +
                         "Keep it under 250 words. Output markdown only.";

            var md = await ThinkTank.CallProvider(
                _activeTemplate.ProviderId,
                personalityMarkdown: "You generate personality profiles for simulated participants.",
                authOverrideJson: _activeTemplate.AuthOverrideJson,
                topic: prompt,
                history: new List<SharedTurn>());

            UpdateActiveTemplate(t => t with { PersonalityMarkdown = md });
            SaveActiveTemplate();
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
        }
        finally
        {
            _generating = false;
        }
    }

    private void OnTemplateNameChanged(ChangeEventArgs e)
        => UpdateActiveTemplate(t => t with { DisplayName = e.Value?.ToString() ?? "" });

    private void OnTemplateProviderChanged(ChangeEventArgs e)
    {
        var providerId = e.Value?.ToString() ?? "openai";
        var providerName = _providerOptions.FirstOrDefault(p => p.Id == providerId).Name ?? providerId;

        UpdateActiveTemplate(t =>
        {
            var firstName = t.DisplayName;
            var idx = firstName.IndexOf(" (", StringComparison.Ordinal);
            if (idx > 0)
                firstName = firstName[..idx];

            return t with { ProviderId = providerId, DisplayName = $"{firstName} ({providerName})" };
        });
    }

    private void OnTemplatePersonalityChanged(ChangeEventArgs e)
        => UpdateActiveTemplate(t => t with { PersonalityMarkdown = e.Value?.ToString() ?? "" });

    private async Task TestTemplate()
    {
        _lastError = null;

        if (_activeTemplate is null)
            return;

        var effectiveKey = ThinkTankSettings.GetKeyForProvider(_activeTemplate.ProviderId, null);
        if (string.IsNullOrWhiteSpace(effectiveKey))
        {
            _lastError = "API key is required. Please check your provider settings.";
            return;
        }

        var chatId = ChatConversationsService.NewId();
        var prompt = "Connectivity test: reply with a single short sentence confirming you can respond.";

        _testing = true;
        Chat.Add(_activeTemplate.DisplayName, $"[TEST {chatId}] Sending: {prompt}");

        try
        {
            var response = await ThinkTank.CallProvider(_activeTemplate.ProviderId, _activeTemplate.PersonalityMarkdown, _activeTemplate.AuthOverrideJson, prompt, history: new List<SharedTurn>());
            Chat.Add(_activeTemplate.DisplayName, $"[TEST {chatId}] Response: {response}");

            await ChatStorage.AppendChatJsonAsync(chatId, new
            {
                id = chatId,
                type = "settings-test",
                participantTemplateId = _activeTemplate.TemplateId,
                providerId = _activeTemplate.ProviderId,
                displayName = _activeTemplate.DisplayName,
                prompt,
                response,
                ts = DateTimeOffset.UtcNow
            });

            await ChatStorage.WritePerspectiveAsync(chatId, _activeTemplate.ProviderId,
                $"# Provider test\n\n- ChatId: `{chatId}`\n- TemplateId: `{_activeTemplate.TemplateId}`\n- Provider: `{_activeTemplate.ProviderId}`\n- DisplayName: `{_activeTemplate.DisplayName}`\n- When: `{DateTimeOffset.UtcNow:o}`\n\n## Notes\n\nThis is a connectivity test run from Settings.\n");
        }
        catch (Exception ex)
        {
            Chat.Add(_activeTemplate.DisplayName, $"[TEST {chatId}] Error: {ex.Message}", isError: true);
            _lastError = ex.Message;
        }
        finally
        {
            _testing = false;
        }
    }

    public void Dispose()
    {
        Chat.Changed -= OnChatChanged;
        _templatePersistDebounceCts?.Cancel();
        _templatePersistDebounceCts?.Dispose();
    }
}
