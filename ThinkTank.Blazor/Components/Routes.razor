<Router AppAssembly="typeof(ThinkTank.Shared.Components.Pages.Home).Assembly"
        AdditionalAssemblies="new[] { typeof(Routes).Assembly }"
        NotFoundPage="typeof(ThinkTank.Shared.Components.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ThinkTank.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
