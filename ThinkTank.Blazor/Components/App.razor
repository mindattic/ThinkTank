    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Think Tank</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/ThinkTank.Shared/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/ThinkTank.Shared/app.css" />
    <link rel="stylesheet" href="ThinkTank.Blazor.styles.css" />
    <link rel="icon" href="data:," />
