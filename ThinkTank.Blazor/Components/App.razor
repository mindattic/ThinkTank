@code {
    // Interactive Server everywhere except pages marked [ExcludeFromInteractiveRouting] (the /Error page),
    // which render once on the server: an error page must not depend on a circuit (TT-T44).
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
