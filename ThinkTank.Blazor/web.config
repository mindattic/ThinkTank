<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit (TT-T48, as Tutor): startup reads and migrates the ThinkTank Azure SQL database before it
           listens, and the first connection after the database has been idle can take about a minute; the 120 s
           default kills the process mid-resume. Only IIS / Azure App Service read this file. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false" stdoutLogFile="\?\%home%\LogFiles\stdout"
                  hostingModel="inprocess" startupTimeLimit="600" />
    </system.webServer>
  </location>
</configuration>
