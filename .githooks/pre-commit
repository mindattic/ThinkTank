#!/bin/bash
# Pre-commit hook: builds the solution before allowing a commit.
# Workspace rule: verification is build-only; tests run only when the owner asks (/test).
# If the build fails, the commit is blocked.

echo "Building ThinkTank.slnx..."
dotnet build ThinkTank.slnx --verbosity quiet --nologo 2>&1

if [ $? -ne 0 ]; then
    echo ""
    echo "COMMIT BLOCKED: the solution does not build. Fix the build before committing."
    exit 1
fi

echo "Build succeeded."
exit 0
